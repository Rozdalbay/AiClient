<Application x:Class="AiDesktopClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Client/Themes/Colors.xaml"/>
                <ResourceDictionary Source="Client/Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Client/Themes/Styles.xaml"/>
                <ResourceDictionary Source="Client/Themes/Buttons.xaml"/>
                <ResourceDictionary Source="Client/Themes/Cards.xaml"/>
                <ResourceDictionary Source="Client/Themes/Controls.xaml"/>
                <ResourceDictionary Source="Client/Themes/Skeleton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
