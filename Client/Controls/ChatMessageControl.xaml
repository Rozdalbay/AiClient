<UserControl x:Class="AiDesktopClient.Controls.ChatMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:AiDesktopClient.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="600"
             Margin="0,4">

    <Border x:Name="MessageBorder"
            CornerRadius="12"
            Padding="16,12"
            Margin="0,2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{DynamicResource PrimaryAccentBrush}"
                            CornerRadius="6"
                            Width="24" Height="24"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="RoleIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="RoleText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           x:Name="TimeText"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl Grid.Row="1"
                          x:Name="AttachmentsList"
                          Margin="0,0,0,8"
                          Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,2"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FileName}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FileSizeDisplay}"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="ErrorBadge"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource UserMessageBackgroundBrush}"
                        BorderBrush="{DynamicResource ErrorAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource ErrorAccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Request failed."
                                   Foreground="{DynamicResource ErrorAccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" Press Regenerate to try again."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                <controls:MarkdownRenderer x:Name="MarkdownContent"
                                           MinHeight="20"/>

                <StackPanel x:Name="GeneratingPlaceholder"
                            Orientation="Horizontal"
                            Margin="0,2,0,4"
                            Visibility="Collapsed">
                    <controls:GeneratingIndicator/>
                </StackPanel>
                </Grid>
            </Grid>

            <StackPanel x:Name="TokenInfoPanel"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                <Border x:Name="TokensBorder"
                        Background="{DynamicResource TertiaryBackgroundBrush}"
                        CornerRadius="6"
                        Padding="8,4"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="TokensText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CostBorder"
                        Background="{DynamicResource TertiaryBackgroundBrush}"
                        CornerRadius="6"
                        Padding="8,4"
                        Margin="0,0,6,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="$"
                                   Foreground="{DynamicResource SuccessAccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="CostText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="TimeBorder"
                        Background="{DynamicResource TertiaryBackgroundBrush}"
                        CornerRadius="6"
                        Padding="8,4"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE967;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="ResponseTimeText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ActionButtons"
                        Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0"
                        Visibility="Collapsed">
                <Button x:Name="CopyButton"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Copy"
                        Click="CopyButton_Click"
                        Width="28" Height="28">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
                <Button x:Name="RegenerateButton"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Regenerate"
                        Click="RegenerateButton_Click"
                        Width="28" Height="28"
                        Margin="2,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
