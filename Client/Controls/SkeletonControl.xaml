<UserControl x:Class="AiDesktopClient.Controls.SkeletonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">
    <Border x:Name="Root"
            Background="{DynamicResource SkeletonBaseBrush}"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid ClipToBounds="True">
            <Rectangle x:Name="ShimmerBand"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Fill="{DynamicResource SkeletonShimmerBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ShimmerTransform" X="-200"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Border>
</UserControl>