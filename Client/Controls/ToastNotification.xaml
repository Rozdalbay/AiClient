<UserControl x:Class="AiDesktopClient.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="320"
             Opacity="0"
             RenderTransformOrigin="0.5,0.5">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="Translate" Y="-20"/>
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <DropShadowEffect x:Key="ToastShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Opacity="0.3"
                          Color="#000000"
                          Direction="270"/>
    </UserControl.Resources>

    <Border x:Name="ToastBorder"
            Background="{StaticResource SurfaceBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Margin="8,4"
            Effect="{StaticResource ToastShadow}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
