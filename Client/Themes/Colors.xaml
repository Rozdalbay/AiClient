<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryAccent">#7C5CFC</Color>
    <Color x:Key="PrimaryAccentHover">#9B7FFD</Color>
    <Color x:Key="SecondaryAccent">#5CA0FC</Color>
    <Color x:Key="SuccessAccent">#5CFCB0</Color>
    <Color x:Key="WarningAccent">#FCE55C</Color>
    <Color x:Key="ErrorAccent">#FC5C7C</Color>
    <Color x:Key="InfoAccent">#5CD4FC</Color>

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccent}"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHover}"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccent}"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="{StaticResource SuccessAccent}"/>
    <SolidColorBrush x:Key="WarningAccentBrush" Color="{StaticResource WarningAccent}"/>
    <SolidColorBrush x:Key="ErrorAccentBrush" Color="{StaticResource ErrorAccent}"/>
    <SolidColorBrush x:Key="InfoAccentBrush" Color="{StaticResource InfoAccent}"/>

    <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource SuccessAccent}"/>
    <SolidColorBrush x:Key="DisconnectedBrush" Color="{StaticResource ErrorAccent}"/>
    <SolidColorBrush x:Key="ConnectingBrush" Color="{StaticResource WarningAccent}"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C5CFC" Offset="0"/>
        <GradientStop Color="#5CA0FC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#267C5CFC" Offset="0"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
