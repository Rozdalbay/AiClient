<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#0D0F18"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#131620"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#1A1D2E"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1E2135"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1D2E"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#131620"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0D0F18"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8E8F0"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8B8D9E"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#5C5E6E"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#0D0F18"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#2A2D3E"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#3A3D4E"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#7C5CFC"/>

    <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#1A2540"/>
    <SolidColorBrush x:Key="UserMessageBorderBrush" Color="#2A3A5C"/>
    <SolidColorBrush x:Key="AssistantMessageBackgroundBrush" Color="#16192A"/>
    <SolidColorBrush x:Key="AssistantMessageBorderBrush" Color="#1E2236"/>

    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#0F1117"/>
    <SolidColorBrush x:Key="CodeHeaderBackgroundBrush" Color="#151825"/>
    <SolidColorBrush x:Key="LineNumberBrush" Color="#3A3D4E"/>

    <SolidColorBrush x:Key="SkeletonBaseBrush" Color="#232739"/>
    <LinearGradientBrush x:Key="SkeletonShimmerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#232739" Offset="0.0"/>
        <GradientStop Color="#3D435D" Offset="0.5"/>
        <GradientStop Color="#232739" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
