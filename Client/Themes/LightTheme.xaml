<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#F6F7FB"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#EEF0F6"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#171827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7085"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9CA0B0"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#E1E3EB"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#C8CBD6"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#7C5CFC"/>

    <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#E8EDF8"/>
    <SolidColorBrush x:Key="UserMessageBorderBrush" Color="#C8D4F0"/>
    <SolidColorBrush x:Key="AssistantMessageBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AssistantMessageBorderBrush" Color="#E1E3EB"/>

    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F0F1F5"/>
    <SolidColorBrush x:Key="CodeHeaderBackgroundBrush" Color="#E6E8EE"/>
    <SolidColorBrush x:Key="LineNumberBrush" Color="#9CA0B0"/>

</ResourceDictionary>
