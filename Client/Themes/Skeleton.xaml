<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AiDesktopClient.Controls">

    <ControlTemplate x:Key="SkeletonChatListScene" TargetType="ContentControl">
        <StackPanel Margin="4,0">
            <Grid Margin="8,8,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="140" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="96" Height="8" CornerRadius="4" HorizontalAlignment="Left"/>
                </StackPanel>
                <controls:SkeletonControl Grid.Column="2" Width="36" Height="8" CornerRadius="4" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="8,8,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="168" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="120" Height="8" CornerRadius="4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
            <Grid Margin="8,8,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="112" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="84" Height="8" CornerRadius="4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="SkeletonMessagesScene" TargetType="ContentControl">
        <StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        MaxWidth="320"
                        Margin="0,0,0,18">
                <controls:SkeletonControl Height="12" CornerRadius="6" Width="210" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <controls:SkeletonControl Height="12" CornerRadius="6" Width="150" HorizontalAlignment="Right"/>
            </StackPanel>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="96" Height="10" CornerRadius="4" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                    <controls:SkeletonControl Width="260" Height="12" CornerRadius="5" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="200" Height="12" CornerRadius="5" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="150" Height="12" CornerRadius="5" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>

            <StackPanel HorizontalAlignment="Right"
                        MaxWidth="280"
                        Margin="0,0,0,18">
                <controls:SkeletonControl Height="12" CornerRadius="6" Width="180" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <controls:SkeletonControl Height="12" CornerRadius="6" Width="220" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <controls:SkeletonControl Height="12" CornerRadius="6" Width="130" HorizontalAlignment="Right"/>
            </StackPanel>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="96" Height="10" CornerRadius="4" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                    <controls:SkeletonControl Width="240" Height="12" CornerRadius="5" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="120" Height="12" CornerRadius="5" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="SkeletonUsageScene" TargetType="ContentControl">
        <StackPanel Margin="20,16">
            <Grid Margin="0,0,0,16">
                <controls:SkeletonControl Width="64" Height="15" CornerRadius="5" HorizontalAlignment="Left"/>
                <controls:SkeletonControl Width="52" Height="18" CornerRadius="6" HorizontalAlignment="Right"/>
            </Grid>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <controls:SkeletonControl Width="44" Height="10" CornerRadius="4" Margin="0,0,0,10"/>
                    <controls:SkeletonControl Width="120" Height="26" CornerRadius="6" Margin="0,0,0,12"/>
                    <controls:SkeletonControl Height="14" CornerRadius="5" Margin="0,0,0,8"/>
                    <controls:SkeletonControl Height="6" CornerRadius="3"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <controls:SkeletonControl Width="52" Height="9" CornerRadius="4" Margin="0,0,0,8"/>
                        <controls:SkeletonControl Width="70" Height="16" CornerRadius="5"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <controls:SkeletonControl Width="64" Height="9" CornerRadius="4" Margin="0,0,0,8"/>
                        <controls:SkeletonControl Width="56" Height="16" CornerRadius="5"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <controls:SkeletonControl Width="120" Height="13" CornerRadius="5" Margin="0,0,0,12"/>
                    <controls:SkeletonControl Height="12" CornerRadius="5" Margin="0,0,0,10"/>
                    <controls:SkeletonControl Height="4" CornerRadius="2" Margin="0,0,0,10"/>
                    <controls:SkeletonControl Height="12" CornerRadius="5" Margin="0,0,0,10"/>
                    <controls:SkeletonControl Height="4" CornerRadius="2"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="14,12">
                <StackPanel>
                    <controls:SkeletonControl Width="96" Height="13" CornerRadius="5" Margin="0,0,0,14"/>
                    <Grid Height="110">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <controls:SkeletonControl Width="16" Height="46" CornerRadius="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <controls:SkeletonControl Width="16" Height="70" CornerRadius="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <controls:SkeletonControl Width="16" Height="38" CornerRadius="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <controls:SkeletonControl Width="16" Height="88" CornerRadius="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <controls:SkeletonControl Width="16" Height="52" CornerRadius="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                            <controls:SkeletonControl Width="16" Height="80" CornerRadius="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                            <controls:SkeletonControl Width="16" Height="44" CornerRadius="4"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="SkeletonModelsScene" TargetType="ContentControl">
        <StackPanel Margin="2,0">
            <Grid Margin="4,6,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="150" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="100" Height="8" CornerRadius="4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
            <Grid Margin="4,6,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="130" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="80" Height="8" CornerRadius="4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
            <Grid Margin="4,6,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:SkeletonControl Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <controls:SkeletonControl Width="160" Height="12" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <controls:SkeletonControl Width="110" Height="8" CornerRadius="4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ControlTemplate>

</ResourceDictionary>