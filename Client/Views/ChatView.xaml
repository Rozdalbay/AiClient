<UserControl x:Class="AiDesktopClient.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AiDesktopClient.Controls"
             xmlns:vm="clr-namespace:AiDesktopClient.ViewModels"
             mc:Ignorable="d"
             xmlns:converters="clr-namespace:AiDesktopClient.Converters"
             d:DesignHeight="600" d:DesignWidth="700">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:IntToVisibilityConverter x:Key="IntToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentChat.Title}"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border x:Name="ModelSelectorBorder"
                            Background="{StaticResource TertiaryBackgroundBrush}"
                            CornerRadius="8"
                            Padding="10,6"
                            Cursor="Hand"
                            MouseLeftButtonDown="ModelSelector_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE99A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{StaticResource PrimaryAccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="SelectedModelText"
                                       Text="Model A"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="8"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Clear chat"
                            Margin="8,0,0,0"
                            Click="ClearChat_Click">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ModelDropdown"
                Grid.Row="0"
                Background="{StaticResource SurfaceBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6"
                Margin="0,44,20,0"
                HorizontalAlignment="Right"
                Width="260"
                MaxHeight="340"
                Visibility="Collapsed"
                VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Select Model"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="8,4,0,6"/>
                    <ItemsControl ItemsSource="{Binding AvailableModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Cursor="Hand"
                                        Margin="0,1"
                                        MouseLeftButtonDown="ModelItem_Click"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{StaticResource PrimaryAccentBrush}"
                                                CornerRadius="6"
                                                Width="28" Height="28"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Provider}"
                                                           Foreground="{StaticResource TertiaryTextBrush}"
                                                           FontSize="11"/>
                                                <TextBlock Text=" • "
                                                           Foreground="{StaticResource TertiaryTextBrush}"
                                                           FontSize="11"/>
                                                <TextBlock Foreground="{StaticResource TertiaryTextBrush}"
                                                           FontSize="11">
                                                    <TextBlock.Text>
                                                        <Binding Path="ContextWindow" StringFormat="{}{0:N0} tokens"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Width="8" Height="8"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SuccessAccent}"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer x:Name="MessagesScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <Grid>
                <ItemsControl x:Name="MessagesList"
                              ItemsSource="{Binding Messages}"
                              Margin="20,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ChatMessageControl Message="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,-60,0,0"
                            Visibility="Collapsed">
                    <Border Background="{StaticResource AccentGradient}"
                            CornerRadius="20" Width="64" Height="64"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="How can I help you?"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Ask me anything — I can help with code, writing, analysis, and more."
                               Foreground="{StaticResource TertiaryTextBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="DropOverlay"
                Grid.Row="1"
                Background="#B30D0F18"
                CornerRadius="0"
                Visibility="Collapsed"
                AllowDrop="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="48"
                           Foreground="{StaticResource PrimaryAccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="Drop files here"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Files will be attached to your message"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding PendingAttachments}"
                      Margin="20,8,20,0"
                      Visibility="{Binding PendingAttachments.Count, Converter={StaticResource IntToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource TertiaryBackgroundBrush}"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       MaxWidth="150"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FileSizeDisplay}"
                                       Foreground="{StaticResource TertiaryTextBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,4,0"/>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Width="20" Height="20"
                                    Tag="{Binding}"
                                    Click="RemoveAttachment_Click">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3"
                Padding="20,8,20,16"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Border Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IconButtonStyle}"
                                Click="AttachButton_Click"
                                ToolTip="Attach file"
                                VerticalAlignment="Center"
                                Margin="4,0">
                            <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>

                        <TextBox x:Name="MessageInput"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="150"
                                 VerticalContentAlignment="Center"
                                 Padding="8,8"
                                 KeyDown="MessageInput_KeyDown"
                                 Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Enter to send • Shift+Enter for new line"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,8"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="{StaticResource TertiaryBackgroundBrush}"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="InputModelBadge"
                                           Text="Model A"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Button x:Name="SendButton"
                                    Command="{Binding SendMessageCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,8"
                                    Visibility="{Binding IsStreaming, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="&#xE724;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"/>
                            </Button>

                            <Button x:Name="StopButton"
                                    Command="{Binding StopGenerationCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="12,8"
                                    Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"
                                    Foreground="{StaticResource ErrorAccentBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="Stop"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
