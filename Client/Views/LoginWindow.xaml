<Window x:Class="AiDesktopClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI Desktop Client"
        Height="600" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Sign in to AI Desktop Client"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
                <Button HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        Style="{StaticResource CloseButtonStyle}"
                        Width="36" Height="28"
                        Margin="0,0,2,0">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="32,8,32,24" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Button x:Name="BackButton"
                            Command="{Binding SwitchModeCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Visibility="Collapsed"
                            Width="28" Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Button>
                    <Border Background="{DynamicResource AccentGradient}"
                            CornerRadius="16" Width="56" Height="56"
                            Margin="4,0,0,0">
                        <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="AI Desktop Client"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Welcome back"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,20"/>

                <TextBlock Text="Username"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"
                         FontSize="13"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Password"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            Padding="4,2"
                            FontSize="11"
                            Cursor="Hand">
                        <TextBlock x:Name="PasswordToggleIcon"
                                   Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TertiaryTextBrush}"/>
                    </Button>
                </Grid>
                <Grid>
                    <PasswordBox x:Name="PasswordBox"
                                 Margin="0,0,0,14"
                                 FontSize="13"/>
                    <TextBox x:Name="PasswordBoxVisible"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"
                             FontSize="13"
                             Visibility="Collapsed"/>
                </Grid>

                <Grid x:Name="ConfirmPasswordGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Confirm Password"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <PasswordBox Grid.Row="1"
                                 x:Name="ConfirmPasswordBox"
                                 Margin="0,0,0,14"
                                 FontSize="13"/>
                </Grid>

                <CheckBox x:Name="RememberMeCheckBox"
                          IsChecked="{Binding RememberMe}"
                          Foreground="{DynamicResource SecondaryTextBrush}"
                          FontSize="12"
                          Margin="0,0,0,16"
                          VerticalContentAlignment="Center">
                    <TextBlock Text="Remember me" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                </CheckBox>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource ErrorAccentBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,12"
                           Visibility="Collapsed"/>

                <Button Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Padding="16,11"
                        FontSize="14">
                    <TextBlock x:Name="SubmitButtonText" Text="Login" FontWeight="SemiBold"/>
                </Button>

                <TextBlock x:Name="ModeLabel"
                           Text="Don't have an account?"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Hyperlink Command="{Binding SwitchModeCommand}"
                               Cursor="Hand">
                        <Run x:Name="SwitchModeLink" Text="Create account"
                             Foreground="{DynamicResource PrimaryAccentBrush}"/>
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </Grid>
    </Border>
</Window>
