<UserControl x:Class="AiDesktopClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AiDesktopClient.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:ConnectionStatusToColorConverter x:Key="StatusColor"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="160" MaxWidth="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20">
                <StackPanel>
                    <TextBlock Text="Settings"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <RadioButton x:Name="NavGeneral"
                                 Style="{StaticResource SidebarItemStyle}"
                                 IsChecked="True"
                                 Click="Nav_Click"
                                 Tag="General"
                                 Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="General" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAppearance"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Click="Nav_Click"
                                 Tag="Appearance"
                                 Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavModels"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Click="Nav_Click"
                                 Tag="Models"
                                 Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Models" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavBackend"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Click="Nav_Click"
                                 Tag="Backend"
                                 Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Backend" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavNotifications"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Click="Nav_Click"
                                 Tag="Notifications"
                                 Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Notifications" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAbout"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Click="Nav_Click"
                                 Tag="About"
                                 Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="30,24">
                <StackPanel>

                <!-- General -->
                <StackPanel x:Name="GeneralPanel" Visibility="Visible">
                    <TextBlock Text="General Settings"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Backend URL" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                            <Button Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Padding="16,8"
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ConnectionTestResult}"
                                       Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding ConnectionTestResult, Converter={StaticResource StringToVis}}">
                                <TextBlock.Foreground>
                                    <Binding Path="ConnectionTestStatus" Converter="{StaticResource StatusColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Streaming" Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Receive responses token by token"
                                           Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding EnableStreaming}"
                                          Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Show Token Count" Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Display token usage per message"
                                           Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowTokenCount}"
                                          Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Show Cost Info" Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Display cost per request"
                                           Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowCostInfo}"
                                          Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                    <TextBlock Text="Appearance"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Theme" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="8,0,0,8" Padding="0" Cursor="Hand"
                                        Background="{DynamicResource TertiaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleDarkThemeCommand}"/>
                                    </Border.InputBindings>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,10">
                                        <Border Background="#0D0F18" CornerRadius="6" Width="48" Height="32"
                                                HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="#E8E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Dark" HorizontalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="0,8,8,0" Padding="0" Cursor="Hand"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleDarkThemeCommand}"/>
                                    </Border.InputBindings>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,10">
                                        <Border Background="#F6F7FB" CornerRadius="6" Width="48" Height="32"
                                                HorizontalAlignment="Center" Margin="0,0,0,6"
                                                BorderBrush="#E1E3EB" BorderThickness="1">
                                            <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="#171827" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Light" HorizontalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Compact Mode" Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Reduce spacing between elements"
                                           Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding CompactMode}"
                                          Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Font Size" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding FontSize, StringFormat='Current: {0}px'}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Models -->
                <StackPanel x:Name="ModelsPanel" Visibility="Collapsed">
                    <TextBlock Text="AI Models"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Available Models" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Models are configured on the backend. Contact your administrator to add or modify models."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                                    CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                                <TextBlock Text="Desktop Client → Backend → AI Provider"
                                           Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11"
                                           FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Backend -->
                <StackPanel x:Name="BackendPanel" Visibility="Collapsed">
                    <TextBlock Text="Backend Configuration"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SECURITY:" Foreground="{DynamicResource WarningAccentBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="API keys of AI providers should NEVER be stored in the desktop frontend. All secrets and authorization must be handled by the backend."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Connection Architecture" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                                    CornerRadius="8" Padding="14,10">
                                <TextBlock Text="Desktop Client → Backend API → AI Provider"
                                           Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="12"
                                           FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Notifications -->
                <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed">
                    <TextBlock Text="Notifications"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Notifications" Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Show toast notifications for actions"
                                           Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding EnableNotifications}"
                                          Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                    <TextBlock Text="About"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center" Margin="20">
                            <Border Background="{DynamicResource AccentGradient}"
                                    CornerRadius="16" Width="60" Height="60"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="AI Desktop Client" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Version 1.0.0" Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="Modern AI desktop application frontend"
                                       Foreground="{DynamicResource TertiaryTextBrush}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
