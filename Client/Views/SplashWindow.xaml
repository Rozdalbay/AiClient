<Window x:Class="AiDesktopClient.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI Desktop Client"
        Height="280" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Border x:Name="RootBorder"
            Opacity="0"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                               ShadowDepth="0"
                               Opacity="0.35"
                               Color="#000000"/>
        </Border.Effect>

        <Grid Margin="34,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">

                <Border x:Name="LogoContainer"
                        Opacity="0"
                        Background="{DynamicResource AccentGradient}"
                        CornerRadius="18" Width="64" Height="64"
                        HorizontalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScaler" ScaleX="0.9" ScaleY="0.9"/>
                    </Border.RenderTransform>
                    <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           Opacity="0"
                           Text="AI Desktop Client"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="19" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock x:Name="SubtitleText"
                           Opacity="0"
                           Text="Your AI workspace"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="4,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Height="2" CornerRadius="1"
                        Background="{DynamicResource TertiaryBackgroundBrush}"
                        Grid.Row="0">
                    <Grid ClipToBounds="True">
                        <Border x:Name="ProgressFill"
                                Height="2"
                                CornerRadius="1"
                                Background="{DynamicResource PrimaryAccentBrush}"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Row="1"
                           Text="Initializing..."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
