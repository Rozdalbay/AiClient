<UserControl x:Class="AiDesktopClient.Views.UsagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AiDesktopClient.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="350">

    <UserControl.Resources>
        <converters:DecimalToCurrencyConverter x:Key="D2C"/>
        <converters:IntToFormattedStringConverter x:Key="I2S"/>
        <converters:ChangePercentToDisplayConverter x:Key="CP2D"/>
        <converters:ChangePercentToColorConverter x:Key="CP2C"/>
        <converters:DoubleToPercentConverter x:Key="D2P"/>
        <converters:RatioToScaleXConverter x:Key="RatioToScaleX"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16">

                <Grid Margin="0,0,0,16">
                    <TextBlock Text="Usage"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right"
                            Background="{DynamicResource TertiaryBackgroundBrush}"
                            CornerRadius="6"
                            Padding="8,4">
                        <TextBlock Text="Today"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Spent"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DailyCost, Converter={StaticResource D2C}}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,4">
                                <TextBlock Text="↓ "
                                           Foreground="{DynamicResource SuccessAccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Foreground="{DynamicResource SuccessAccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding Path="CostChangePercent" Converter="{StaticResource CP2D}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="of "
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       FontSize="11"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       FontSize="11">
                                <TextBlock.Text>
                                    <Binding Path="BudgetLimit" Converter="{StaticResource D2C}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                                CornerRadius="3"
                                Height="6">
                            <Border HorizontalAlignment="Left"
                                    CornerRadius="3"
                                    Background="{DynamicResource AccentGradient}">
                                <Border.RenderTransform>
                                    <ScaleTransform>
                                        <ScaleTransform.ScaleX>
                                            <MultiBinding Converter="{StaticResource RatioToScaleX}">
                                                <Binding Path="DailyCost"/>
                                                <Binding Path="BudgetLimit"/>
                                            </MultiBinding>
                                        </ScaleTransform.ScaleX>
                                    </ScaleTransform>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tokens"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DailyTokens, Converter={StaticResource I2S}}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Foreground="{DynamicResource SuccessAccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <Binding Path="TokenChangePercent" Converter="{StaticResource CP2D}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Requests"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DailyRequests, Converter={StaticResource I2S}}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Foreground="{DynamicResource SuccessAccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <Binding Path="RequestChangePercent" Converter="{StaticResource CP2D}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Model Statistics"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding ModelStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ModelName}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Cost, Converter={StaticResource D2C}}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock Grid.Column="2"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   MinWidth="36"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <Binding Path="Percentage" StringFormat="{}{0:F0}%"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                                            CornerRadius="2"
                                            Height="4"
                                            Margin="0,0,0,4">
                                        <Border HorizontalAlignment="Left"
                                                CornerRadius="2"
                                                Background="{DynamicResource PrimaryAccentBrush}">
                                            <Border.Width>
                                                <Binding Path="Percentage">
                                                    <Binding.Converter>
                                                        <converters:PercentToWidthConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Border.Width>
                                        </Border>
                                    </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cost Dynamics"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <Grid Height="120" Margin="0,0,0,4">
                            <Canvas x:Name="GraphCanvas"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mon" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Tue" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Wed" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Thu" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Fri" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Sat" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Sun" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="✓ "
                                       Foreground="{DynamicResource SuccessAccentBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding AccountUsername, FallbackValue=Account}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AccountStatus, FallbackValue=Local account}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                                CornerRadius="6"
                                Padding="10,8">
                            <TextBlock Text="Signed in locally · data stays on this device"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       FontSize="10"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
